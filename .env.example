# Copy to `.env` (docker compose reads it automatically). Change every secret.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=please-change-this-root-password
MYSQL_DATABASE=alphaq
MYSQL_USER=alphaq
MYSQL_PASSWORD=please-change-this-db-password

# --- App ---
# Signs login tokens — make it long and random (e.g. `openssl rand -hex 32`).
JWT_SECRET=please-change-this-to-a-long-random-string
# Comma-separated phone numbers that become admins.
ADMIN_PHONES=9573976462
# Password for the auto-created admin on first run. Change it, then log in.
ADMIN_PASSWORD=change-this-admin-password

# --- Email (SMTP Configuration) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=v9347976462@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM="AlphaQ Gaming" <v9347976462@gmail.com>
ADMIN_EMAIL=v9347976462@gmail.com

# --- OTP Configuration ---
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
