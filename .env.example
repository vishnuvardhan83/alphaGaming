# AlphaQ Gaming — Environment Configuration Template (Koyeb Web Service)
# Copy to `.env` for local testing. In Koyeb, configure these in Environment Variables.

NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Database Configuration (MySQL)
DB_CLIENT=mysql
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Security & Tokens
JWT_SECRET=

# Gmail SMTP Configuration (Nodemailer on Port 587 with TLS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=AlphaQ Gaming

# Admin Configuration
ADMIN_EMAIL=
ADMIN_PHONES=9573976462

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
