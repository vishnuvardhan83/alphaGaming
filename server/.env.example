# AlphaQ server configuration — copy this file to `.env` and edit.
# Anything left unset falls back to a safe default.

# ---- Web server ----
PORT=4000
# Long random string — signs login tokens. CHANGE THIS in production.
JWT_SECRET=change-me-to-a-long-random-string

# ---- Admin bootstrap ----
# Comma-separated phone numbers that become admins on first login/register.
ADMIN_PHONES=9573976462
# Password for the auto-created admin account on first run. Change it after.
ADMIN_PASSWORD=admin123

# ---- Database ----
# DB_CLIENT = mysql | sqlite   (default: sqlite unless MySQL vars are set below)
DB_CLIENT=mysql

# MySQL connection (standard variables)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=alphaq
MYSQL_PASSWORD=alphaq_password
MYSQL_DATABASE=alphaq

# Railway MySQL automatically provides these (supported out of the box):
# MYSQLHOST=
# MYSQLPORT=
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=
# MYSQL_URL=
# DATABASE_URL=mysql://alphaq:alphaq_password@localhost:3306/alphaq

# SQLite (used when DB_CLIENT=sqlite) — optional custom path.
# SQLITE_PATH=./data/alphaq.db

# ---- Email (SMTP Configuration) ----
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=v9347976462@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM="AlphaQ Gaming" <v9347976462@gmail.com>
ADMIN_EMAIL=v9347976462@gmail.com

# ---- OTP & Verification Security ----
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
