rules_version = '2';

// AlphaQ Gaming — Firestore security rules.
// Catalogue (games/food/tournaments) is world-readable; only admins write it.
// Bookings, food orders and registrations are private to their owner + admins.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function ownsNew() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function ownsExisting() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    // User profiles: a user reads/writes their own; admins can read all.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Public catalogue — anyone can read, only admins can manage.
    match /games/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /food/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /tournaments/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bookings — owner creates/reads/cancels; admins manage all.
    match /bookings/{id} {
      allow read: if ownsExisting() || isAdmin();
      allow create: if ownsNew();
      allow update, delete: if ownsExisting() || isAdmin();
    }

    // Food orders — owner creates/reads; admins update status.
    match /foodOrders/{id} {
      allow read: if ownsExisting() || isAdmin();
      allow create: if ownsNew();
      allow update, delete: if ownsExisting() || isAdmin();
    }

    // Tournament registrations — owner creates/reads; admins read all.
    match /tournamentRegistrations/{id} {
      allow read: if ownsExisting() || isAdmin();
      allow create: if ownsNew();
      allow update, delete: if ownsExisting() || isAdmin();
    }
  }
}
