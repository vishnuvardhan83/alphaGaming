# AlphaQ Gaming backend — example configuration (copy to .env / export before running).
# NEVER commit real secrets. These local-dev defaults match backend/db/setup-local-mysql.sql.

# Docker MySQL runs on host port 3307 (see backend/docker-compose.yml)
DB_URL=jdbc:mysql://localhost:3307/alphaq_gaming?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USERNAME=alphaq
DB_PASSWORD=alphaq_dev_pw

SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Must be >= 32 bytes in production
APP_JWT_SECRET=alphaq-dev-secret-change-me-please-32bytes-min
APP_JWT_TTL_MINUTES=720

# ---- OTP delivery -----------------------------------------------------------
# 'mock'    = code prints to console + returns in API for UI auto-fill (dev).
# 'msg91'   = real SMS via MSG91.
# 'textbee' = real SMS via a paired Android phone (TextBee).
# For any real provider, also set OTP_EXPOSE_IN_RESPONSE=false.
OTP_PROVIDER=mock
OTP_EXPOSE_IN_RESPONSE=true

# MSG91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=ALPHAQ

# TextBee (Android SMS gateway) — from the TextBee dashboard after pairing your phone
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
# TEXTBEE_COUNTRY_CODE=91
